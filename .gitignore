# ---- 编译产物 ----
# 构建脚本本身在 build/（属于仓库内容），它们写出的东西全部落在 build/out/：
# exe、zip、安装包、Nuitka 中间目录，都能用脚本随时重建。
/build/out/

# 兜底：万一手动在仓库根目录直接跑 Nuitka，这些中间目录同样不该进仓库
*.build/
*.dist/
*.onefile-build/

# ---- 凭证：绝对不要提交 ----
sessdata.txt
sessdata
.env

# ---- 下载产物与断点临时文件 ----
bili_downloads/
*.part
*.m4s

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 编辑器 / 系统 ----
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
